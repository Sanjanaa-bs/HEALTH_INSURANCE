# Health Insurance Intelligence Platform Environment Configuration

# Application
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="Health Insurance Intelligence Platform"

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
# Use relative SQLite path within the backend folder or absolute path
DATABASE_URL=sqlite:///./health_insurance.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# RAG Pipeline Configuration (Hybrid Retrieval + Semantic Embeddings + LLM)
# ==============================================================================
# Embedding Provider: "local" (built-in zero-dependency dense vectorizer),
#                     "sentence-transformers", or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./vector_index.json

# Hybrid Retrieval: Weight balance between BM25 keyword score and Vector cosine similarity (0.0 to 1.0)
RAG_HYBRID_ALPHA=0.5
RAG_MAX_CITATIONS=5

# LLM Generative Answering: "auto", "openai", "gemini", "ollama", or "fallback"
# Note: When no API key is supplied, the platform automatically uses the deterministic
# evidence-grounded synthesis fallback engine.
LLM_PROVIDER=ollama
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2
