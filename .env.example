# Health Insurance Intelligence Platform Environment Configuration

# Application
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="Health Insurance Intelligence Platform"

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
# Use relative SQLite path within the backend folder or absolute path
DATABASE_URL=sqlite:///./health_insurance.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM / Embedding Providers (leave blank or fill when adding RAG features)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
